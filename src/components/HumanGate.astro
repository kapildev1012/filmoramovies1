---
// HumanGate.astro — "Are you human?" verification gate.
// Modern, privacy-friendly verification with Cloudflare Turnstile & instant fallback.
const SITE_KEY = '1x00000000000000000000AA';
---

<div id="human-gate" class="hg-container" role="dialog" aria-modal="true" aria-labelledby="hg-title" aria-describedby="hg-desc">
  {/* Dark backdrop blur */}
  <div class="hg-backdrop"></div>

  {/* Verification Card */}
  <div class="hg-card">
    {/* Subtle top hairline highlight */}
    <div class="hg-top-glow" aria-hidden="true"></div>

    {/* Security shield icon badge */}
    <div class="hg-badge" aria-hidden="true">
      <div class="hg-badge-glow"></div>
      <svg class="hg-shield-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        <path d="m9 12 2 2 4-4" />
      </svg>
    </div>

    <div class="hg-header">
      <div class="hg-pill">
        <span class="hg-pill-dot" aria-hidden="true"></span>
        <span>Security Verification</span>
      </div>
      <h1 id="hg-title" class="hg-title">Verify You're Human</h1>
      <p id="hg-desc" class="hg-desc">
        A quick browser verification to protect Filmora Movie from automated scrapers and bots.
      </p>
    </div>

    {/* Turnstile / Interactive Widget */}
    <div class="hg-widget-area">
      <div
        class="cf-turnstile"
        data-sitekey={SITE_KEY}
        data-callback="onHumanVerified"
        data-error-callback="onHumanError"
        data-theme="dark"
      ></div>

      {/* Manual Quick Button (shown if turnstile takes time or is blocked by adblock) */}
      <div id="hg-manual-wrap" class="hg-manual-wrap">
        <button
          type="button"
          id="hg-manual-btn"
          class="hg-verify-btn"
          onclick="window.onHumanVerified()"
        >
          <span class="hg-check-box" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </span>
          <span>I am human · Continue to Filmora</span>
        </button>
      </div>
    </div>

    {/* Status & Footer */}
    <div class="hg-footer">
      <p id="hg-status" class="hg-status" role="status" aria-live="polite">
        <span class="hg-dot"></span> Checking browser integrity…
      </p>
      <p class="hg-fine">
        <svg class="hg-lock-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
        <span>Protected by Cloudflare Turnstile &amp; Filmora Guard</span>
      </p>
    </div>
  </div>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline>
  (function () {
    var KEY = 'nx_human_ok';

    function isPreview() {
      try {
        var p = new URLSearchParams(window.location.search);
        return p.has('preview_gate') || p.has('verify') || p.has('gate');
      } catch (e) {
        return false;
      }
    }

    function isVerified() {
      if (isPreview()) return false;
      try {
        return sessionStorage.getItem(KEY) === '1' || document.cookie.indexOf('filmora_human=1') !== -1;
      } catch (e) {
        return false;
      }
    }

    function hideGate() {
      var g = document.getElementById('human-gate');
      document.documentElement.classList.remove('hg-lock');
      if (!g) return;
      g.classList.add('hg-done');
      window.setTimeout(function () {
        g.style.display = 'none';
      }, 350);
    }

    function lockGate() {
      var g = document.getElementById('human-gate');
      if (g) {
        document.documentElement.classList.add('hg-lock');
        g.style.display = 'flex';
        // If in preview mode, reveal the manual button immediately for visual verification
        if (isPreview()) {
          var manual = document.getElementById('hg-manual-wrap');
          if (manual) manual.style.display = 'block';
        }
      }
    }

    // Global callbacks
    window.onHumanVerified = function () {
      if (!isPreview()) {
        try {
          sessionStorage.setItem(KEY, '1');
          document.cookie = 'filmora_human=1; path=/; max-age=86400; SameSite=Lax';
        } catch (e) {}
      }
      var s = document.getElementById('hg-status');
      if (s) {
        s.innerHTML = '<span class="hg-dot is-success"></span> Verified! Entering Filmora…';
      }
      if (!isPreview()) {
        hideGate();
      }
    };

    window.onHumanError = function () {
      var s = document.getElementById('hg-status');
      if (s) {
        s.innerHTML = '<span class="hg-dot is-error"></span> Verification required. Click button below:';
      }
      var manual = document.getElementById('hg-manual-wrap');
      if (manual) manual.style.display = 'block';
    };

    // Auto-reveal manual verify button after 2s if Turnstile is blocked or taking time
    window.setTimeout(function () {
      var manual = document.getElementById('hg-manual-wrap');
      if (manual && !isVerified()) {
        manual.style.display = 'block';
      }
    }, 2000);

    if (isVerified()) {
      hideGate();
    } else {
      lockGate();
    }
  })();
</script>

<style is:global>
  html.hg-lock,
  html.hg-lock body {
    overflow: hidden !important;
    height: 100% !important;
  }

  html.nx-verified #human-gate {
    display: none !important;
  }

  .hg-container {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 1;
    transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1), transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hg-container.hg-done {
    opacity: 0;
    transform: scale(0.97);
    pointer-events: none;
  }

  .hg-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 3, 5, 0.92);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
  }

  .hg-card {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 420px;
    padding: 2.25rem 2rem;
    border-radius: 24px;
    background: linear-gradient(180deg, #0e0c16 0%, #06050a 100%);
    border: 1px solid rgba(147, 51, 234, 0.22);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.08),
      0 24px 64px -16px rgba(0, 0, 0, 0.9),
      0 0 50px -12px rgba(124, 58, 237, 0.18);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    overflow: hidden;
  }

  /* Subtle purple ambient gradient at the top edge of the card */
  .hg-top-glow {
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.6), transparent);
  }

  .hg-badge {
    position: relative;
    width: 58px;
    height: 58px;
    border-radius: 18px;
    background: linear-gradient(145deg, #19122b 0%, #0e0a19 100%);
    border: 1px solid rgba(168, 85, 247, 0.35);
    display: grid;
    place-items: center;
    color: #ffffff;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      0 8px 24px -4px rgba(124, 58, 237, 0.35);
  }

  .hg-badge-glow {
    position: absolute;
    inset: -3px;
    border-radius: 20px;
    background: #7c3aed;
    opacity: 0.25;
    filter: blur(10px);
    z-index: -1;
    animation: hg-pulse 3s ease-in-out infinite alternate;
  }

  @keyframes hg-pulse {
    0% { transform: scale(0.96); opacity: 0.18; }
    100% { transform: scale(1.05); opacity: 0.35; }
  }

  .hg-shield-icon {
    color: #ffffff;
    filter: drop-shadow(0 2px 6px rgba(147, 51, 234, 0.4));
  }

  .hg-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
  }

  .hg-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #c084fc;
    background: rgba(147, 51, 234, 0.1);
    border: 1px solid rgba(147, 51, 234, 0.25);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .hg-pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #a855f7;
    box-shadow: 0 0 6px #a855f7;
  }

  .hg-title {
    font-size: 1.4375rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
  }

  .hg-desc {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
    margin: 0;
    max-width: 320px;
    text-wrap: pretty;
  }

  .hg-widget-area {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 68px;
  }

  .hg-manual-wrap {
    width: 100%;
    margin-top: 0.5rem;
  }

  .hg-verify-btn {
    width: 100%;
    padding: 0.875rem 1.25rem;
    border-radius: 14px;
    background: linear-gradient(180deg, #7c3aed 0%, #6d28d9 100%);
    border: 1px solid rgba(216, 180, 254, 0.35);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      0 8px 24px -4px rgba(124, 58, 237, 0.45);
    transition: transform 150ms ease, box-shadow 150ms ease, background 150ms ease;
  }

  .hg-verify-btn:hover {
    background: linear-gradient(180deg, #8b5cf6 0%, #7c3aed 100%);
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 12px 28px -4px rgba(139, 92, 246, 0.55);
  }

  .hg-verify-btn:active {
    transform: scale(0.98);
  }

  .hg-verify-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px #000000, 0 0 0 4px #a855f7;
  }

  .hg-check-box {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.3);
    color: #ffffff;
  }

  .hg-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .hg-status {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
  }

  .hg-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #a855f7;
    box-shadow: 0 0 6px #a855f7;
    animation: hg-pulse 1.2s infinite;
  }

  .hg-dot.is-success {
    background: #22c55e;
    box-shadow: 0 0 6px #22c55e;
    animation: none;
  }

  .hg-dot.is-error {
    background: #f59e0b;
    box-shadow: 0 0 6px #f59e0b;
    animation: none;
  }

  .hg-fine {
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .hg-lock-icon {
    color: rgba(255, 255, 255, 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .hg-container,
    .hg-verify-btn,
    .hg-badge-glow,
    .hg-dot {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

