---
// src/pages/channels.astro — Live TV & Streaming Channels
import Layout from '../layouts/Layout.astro';
import LiveChannels from '../components/react/LiveChannels';
---

<Layout title="Live Channels & TV Guide — Filmora" description="Watch 24/7 live streaming channels across sports, movies, news, kids, and documentary.">
  <div class="container mx-auto px-4 py-8 md:py-12 space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span> 24/7 LIVE STREAMING
        </div>
        <h1 class="text-3xl md:text-5xl font-black tracking-tight text-white">
          Live Channels &amp; TV
        </h1>
        <p class="text-sm text-white/60 mt-1 max-w-xl">
          Stream live sports, international cinema, breaking news, cartoons, and documentaries with full real-time EPG show guides.
        </p>
      </div>

      <a
        href="/calendar"
        class="hidden sm:inline-flex px-4 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-white font-bold text-xs transition-all border border-white/10 items-center gap-2 active:scale-95"
      >
        <svg class="w-4 h-4 text-white/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Airing Calendar</span>
      </a>
    </div>

    <LiveChannels client:load />
  </div>
</Layout>
