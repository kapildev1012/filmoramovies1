---
// src/pages/profile.astro — User Account & Streaming Control Center
import Layout from '../layouts/Layout.astro';
import ProfileControlCenter from '../components/react/profile/ProfileControlCenter';
import { getSessionFromRequest, getProfilesByUserId, getWatchlist } from '../lib/db';
import { getDB } from '../lib/db-driver';

// Auth gate
const db = await getDB(Astro.locals);
const session = await getSessionFromRequest(db, Astro.request);

if (!session) {
  return Astro.redirect('/login?return=/profile');
}

const user = session.user;
const profiles = await getProfilesByUserId(db, user.id);
const activeProfile = profiles.find((p) => p.is_default) ?? profiles[0] ?? null;
const watchlist = activeProfile ? await getWatchlist(db, activeProfile.id) : [];
---

<Layout
  title={`${user.name} — Account & Streaming Control Center — Filmora`}
  description="Manage your Filmora user account, household viewing profiles, streaming preferences, playback settings, and watch history."
  user={user}
>
  <div class="relative min-h-screen bg-black overflow-hidden">
    {/* ── Kinetic Ambient Aura Mesh Blobs (Softened for OLED Pure Black) ── */}
    <div class="absolute -top-10 left-1/4 w-[550px] h-[550px] bg-purple-600/10 rounded-full blur-[160px] pointer-events-none -z-10 animate-aura hidden sm:block" />
    <div class="absolute top-64 right-1/4 w-[500px] h-[500px] bg-rose-600/10 rounded-full blur-[160px] pointer-events-none -z-10 animate-aura hidden sm:block" style="animation-delay: -5s;" />

    <main class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 pt-3 sm:pt-4 pb-24 relative z-10">
      <ProfileControlCenter
        client:load
        initialUser={user}
        initialProfiles={profiles}
        initialActiveProfile={activeProfile}
        initialWatchlist={watchlist}
      />
    </main>
  </div>
</Layout>
