---
// src/pages/watchlist.astro — Auth-gated & Guest-Supported Watchlist Page
import Layout from '../layouts/Layout.astro';
import { getSessionFromRequest, getProfilesByUserId, getWatchlist } from '../lib/db';
import type { DBWatchlistEntry } from '../lib/db';
import { getDB } from '../lib/db-driver';

const TMDB_IMG = 'https://image.tmdb.org/t/p';

const db = await getDB(Astro.locals);
const session = await getSessionFromRequest(db, Astro.request);

let entries: DBWatchlistEntry[] = [];
let activeProfile: any = null;

if (session) {
  const profiles = await getProfilesByUserId(db, session.user.id);
  activeProfile = profiles.find((p) => p.is_default) ?? profiles[0] ?? null;
  if (activeProfile) {
    entries = await getWatchlist(db, activeProfile.id);
  }
}

// URL Params & Filter Logic
const url = new URL(Astro.request.url);
const filterType = url.searchParams.get('type') || 'all';
const sortBy = url.searchParams.get('sort') || 'newest';

let filtered = entries.filter((e) => {
  if (filterType === 'movie') return e.media_type === 'movie';
  if (filterType === 'tv') return e.media_type === 'tv';
  return true;
});

if (sortBy === 'alpha') {
  filtered = [...filtered].sort((a, b) => a.title.localeCompare(b.title));
} else {
  filtered = [...filtered].sort(
    (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime()
  );
}

function filterUrl(type: string) {
  const params = new URLSearchParams(url.searchParams);
  params.set('type', type);
  return `/watchlist?${params.toString()}`;
}

function sortUrl(sort: string) {
  const params = new URLSearchParams(url.searchParams);
  params.set('sort', sort);
  return `/watchlist?${params.toString()}`;
}
---

<Layout
  title="My Watchlist — Filmora"
  user={session?.user ?? null}
>
  <div class="min-h-screen bg-black text-white">
    <div class="container mx-auto px-3 sm:px-4 py-4 sm:py-8 max-w-7xl watchlist-page space-y-5">
      
      {/* ── Header ── */}
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-white/10">
        <div>
          <div class="flex items-center gap-3">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-white tracking-tight flex items-center gap-2">
              <span>My Watchlist</span>
            </h1>
            {activeProfile && (
              <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-white/10 border border-white/20 text-white/90">
                {activeProfile.name}
              </span>
            )}
          </div>
          <p class="text-xs sm:text-sm text-white/50 mt-1" data-wl-count>
            {filtered.length} saved title{filtered.length !== 1 ? 's' : ''} synced across all your devices
          </p>
        </div>

        {/* Quick Action Links */}
        <div class="flex items-center gap-2 self-start sm:self-auto">
          <a href="/movies" class="px-3.5 py-1.5 rounded-xl bg-white/10 hover:bg-white hover:text-black border border-white/15 text-white text-xs font-bold transition-all active:scale-95 shadow">
            + Movies
          </a>
          <a href="/series" class="px-3.5 py-1.5 rounded-xl bg-white/10 hover:bg-white hover:text-black border border-white/15 text-white text-xs font-bold transition-all active:scale-95 shadow">
            + Series
          </a>
        </div>
      </div>

      {/* ── Controls Deck (Filters, Search, Sort) ── */}
      <div class="space-y-3">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
          
          {/* Type Filter Pills (Mobile continuous scroll strip) */}
          <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none snap-x snap-mandatory" role="group" aria-label="Filter by type">
            <a
              href={filterUrl('all')}
              class={`px-4 py-2 rounded-xl text-xs font-bold transition-all active:scale-95 whitespace-nowrap border snap-center shadow-sm ${
                filterType === 'all'
                  ? 'bg-white text-black border-white shadow-md font-black'
                  : 'bg-neutral-950 border-white/15 text-white/70 hover:bg-neutral-900 hover:text-white'
              }`}
            >
              All <span class="opacity-60 text-[11px]">({entries.length})</span>
            </a>
            <a
              href={filterUrl('movie')}
              class={`px-4 py-2 rounded-xl text-xs font-bold transition-all active:scale-95 whitespace-nowrap border snap-center shadow-sm ${
                filterType === 'movie'
                  ? 'bg-white text-black border-white shadow-md font-black'
                  : 'bg-neutral-950 border-white/15 text-white/70 hover:bg-neutral-900 hover:text-white'
              }`}
            >
              Movies <span class="opacity-60 text-[11px]">({entries.filter(e => e.media_type === 'movie').length})</span>
            </a>
            <a
              href={filterUrl('tv')}
              class={`px-4 py-2 rounded-xl text-xs font-bold transition-all active:scale-95 whitespace-nowrap border snap-center shadow-sm ${
                filterType === 'tv'
                  ? 'bg-white text-black border-white shadow-md font-black'
                  : 'bg-neutral-950 border-white/15 text-white/70 hover:bg-neutral-900 hover:text-white'
              }`}
            >
              Series <span class="opacity-60 text-[11px]">({entries.filter(e => e.media_type === 'tv').length})</span>
            </a>
          </div>

          {/* Search & Sort Controls */}
          <div class="flex items-center gap-2 w-full md:w-auto">
            <div class="relative flex-1 md:w-64">
              <input
                type="search"
                class="w-full h-10 pl-9 pr-3 rounded-xl bg-neutral-950 border border-white/20 text-white text-xs placeholder:text-white/40 focus:outline-none focus:border-white transition-colors font-medium shadow-inner"
                placeholder="Search watchlist…"
                aria-label="Search within watchlist"
                data-wl-search
              />
              <svg class="absolute left-3 top-3 w-4 h-4 text-white/40 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>

            <div class="flex-none">
              <select
                id="sort-select"
                class="h-10 px-3.5 rounded-xl bg-neutral-950 border border-white/20 text-white text-xs font-bold focus:outline-none focus:border-white cursor-pointer shadow"
                onchange="window.location.href = this.value"
              >
                <option value={sortUrl('newest')} selected={sortBy === 'newest'}>Newest Added</option>
                <option value={sortUrl('alpha')} selected={sortBy === 'alpha'}>Title (A – Z)</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      {/* ── Watchlist Content Grid ── */}
      <div id="wl-container">
        {entries.length === 0 ? (
          <div class="watchlist-empty py-16 text-center space-y-4 rounded-3xl border border-white/15 bg-neutral-950 p-6 shadow-2xl">
            <div class="w-14 h-14 mx-auto rounded-2xl bg-white/10 border border-white/15 flex items-center justify-center text-white/60 text-2xl">
              🔖
            </div>
            <div class="space-y-1">
              <h2 class="text-base sm:text-lg font-black text-white">Your watchlist is empty</h2>
              <p class="text-xs text-white/50 max-w-sm mx-auto">
                Bookmark movies and TV shows from the home or explore pages to start streaming them here anytime.
              </p>
            </div>
            <div class="flex items-center justify-center gap-2.5 pt-2">
              <a href="/movies" class="px-5 py-2.5 rounded-xl bg-white text-black font-black text-xs uppercase tracking-wider shadow-lg active:scale-95 transition-all">
                Explore Movies
              </a>
              <a href="/series" class="px-5 py-2.5 rounded-xl bg-neutral-900 border border-white/20 text-white font-bold text-xs hover:bg-neutral-800 active:scale-95 transition-all">
                Explore Series
              </a>
            </div>
          </div>
        ) : filtered.length === 0 ? (
          <div class="py-12 text-center space-y-3 rounded-2xl border border-white/15 bg-neutral-950 p-6">
            <p class="text-xs sm:text-sm text-white/60">No {filterType === 'movie' ? 'movies' : 'series'} found in your watchlist.</p>
            <a href={filterUrl('all')} class="inline-block px-4 py-2 rounded-xl bg-white text-black font-bold text-xs">
              Show All Items
            </a>
          </div>
        ) : (
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2.5 sm:gap-4 watchlist-grid" role="list">
            {filtered.map((entry) => {
              const posterUrl = entry.poster_path
                ? `${TMDB_IMG}/w342${entry.poster_path}`
                : null;
              const href = entry.media_type === 'movie'
                ? `/movie/${entry.tmdb_id}`
                : `/series/${entry.tmdb_id}`;
              const addedDate = new Date(entry.added_at).toLocaleDateString('en-US', {
                month: 'short', day: 'numeric'
              });
              return (
                <article class="wl-card group relative flex flex-col bg-black rounded-2xl overflow-hidden border border-white/15 hover:border-white/40 transition-all hover:-translate-y-1 shadow-2xl select-none" role="listitem">
                  <a href={href} class="wl-card-link block relative aspect-[2/3] w-full overflow-hidden bg-neutral-950" aria-label={entry.title}>
                    {posterUrl ? (
                      <img
                        src={posterUrl}
                        alt={entry.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                        width="342"
                        height="513"
                        decoding="async"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-white/30 text-xs">
                        No Poster
                      </div>
                    )}

                    {/* Gradient Scrim */}
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/40 opacity-70 group-hover:opacity-90 transition-opacity" />

                    {/* Media Type Badge */}
                    <span class="absolute top-2 left-2 text-[9px] font-black uppercase px-2 py-0.5 rounded bg-black/70 text-white/90 border border-white/20 backdrop-blur-md">
                      {entry.media_type === 'movie' ? 'Film' : 'Series'}
                    </span>

                    {/* Quick Remove Button (44px mobile touch target) */}
                    <button
                      type="button"
                      class="wl-remove-btn absolute top-1.5 right-1.5 w-9 h-9 flex items-center justify-center rounded-full bg-black/80 hover:bg-rose-600 text-white/80 hover:text-white border border-white/20 hover:border-rose-400 backdrop-blur-md transition-all active:scale-90 z-20 shadow-lg"
                      aria-label={`Remove ${entry.title} from watchlist`}
                      data-tmdb-id={entry.tmdb_id}
                      data-media-type={entry.media_type}
                    >
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2.5} d="M6 18L18 6M6 6l12 12" />
                      </svg>
                    </button>
                  </a>

                  {/* Card Info & Play Button */}
                  <div class="p-2.5 flex-1 flex flex-col justify-between space-y-2">
                    <div>
                      <a href={href} class="wl-card-title block font-bold text-white text-xs truncate group-hover:text-white transition-colors">
                        {entry.title}
                      </a>
                      <span class="text-[10px] text-white/40 font-mono block mt-0.5">
                        Added {addedDate}
                      </span>
                    </div>

                    <a
                      href={href}
                      class="w-full py-2 px-2 rounded-xl bg-white hover:bg-neutral-200 text-black text-[11px] font-black uppercase tracking-wider text-center transition-all flex items-center justify-center gap-1.5 active:scale-95 shadow"
                    >
                      <span>Watch</span>
                      <span class="text-xs">➔</span>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
  function setupRemoveButtons() {
    document.querySelectorAll<HTMLButtonElement>('.wl-remove-btn').forEach((btn) => {
      btn.addEventListener('click', async function (e) {
        e.preventDefault();
        e.stopPropagation();

        const tmdbId = parseInt(this.dataset.tmdbId ?? '');
        const mediaType = this.dataset.mediaType;
        if (!tmdbId || !mediaType) return;

        const card = this.closest('.wl-card') as HTMLElement | null;
        if (card) {
          card.style.opacity = '0';
          card.style.transform = 'scale(0.92)';
          card.style.transition = 'all 0.25s ease';
          setTimeout(() => card.remove(), 250);
        }

        try {
          const raw = JSON.parse(localStorage.getItem('filmora_watchlist') || '[]');
          const next = raw.filter((w: any) => !(Number(w.id) === tmdbId && w.mediaType === mediaType));
          localStorage.setItem('filmora_watchlist', JSON.stringify(next));
          window.dispatchEvent(new CustomEvent('filmora:watchlist-updated'));

          await fetch('/api/watchlist', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tmdbId, mediaType }),
          });
        } catch {}
      });
    });
  }

  function hydrateGuestWatchlist() {
    try {
      const raw = JSON.parse(localStorage.getItem('filmora_watchlist') || '[]');
      if (Array.isArray(raw) && raw.length > 0) {
        fetch('/api/watchlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ syncItems: raw }),
        }).catch(() => {});
      }
    } catch {}
  }

  function setupSearch() {
    const wlSearch = document.querySelector<HTMLInputElement>('[data-wl-search]');
    wlSearch?.addEventListener('input', () => {
      const term = wlSearch.value.trim().toLowerCase();
      document.querySelectorAll<HTMLElement>('.wl-card').forEach((card) => {
        const title = card.querySelector('.wl-card-title')?.textContent?.toLowerCase() ?? '';
        card.style.display = !term || title.includes(term) ? '' : 'none';
      });
    });
  }

  setupRemoveButtons();
  hydrateGuestWatchlist();
  setupSearch();
  document.addEventListener('astro:page-load', () => {
    setupRemoveButtons();
    hydrateGuestWatchlist();
    setupSearch();
  });
</script>
