# ════════════════════════════════════════════════════════════════
# Filmora Movie — Environment Variables Configuration
# ════════════════════════════════════════════════════════════════

# ─── Public Site URL ──────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:4321

# ─── TMDB (The Movie Database) API Key ───────────────────────────
TMDB_API_KEY=e8278bd7a1c03b9c0817e04e90b7a4c3

# ─── AI Recommendations Gateway ─────────────────────────────────
NexS_api=nx_4a1d3c31bf26e0aae6f04909e376b608
EMBED_API_KEY=nx_4a1d3c31bf26e0aae6f04909e376b608

# ─── 1. Google OAuth 2.0 (Real ID) ──────────────────────────────
# Setup: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:4321/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/google/callback

# ─── 2. Discord OAuth 2.0 (Real ID) ─────────────────────────────
# Setup: https://discord.com/developers/applications
# Redirect URI: http://localhost:4321/api/auth/discord/callback
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:4321/api/auth/discord/callback

# ─── 3. Twitter / X OAuth 2.0 (Real ID) ─────────────────────────
# Setup: https://developer.x.com/en/portal/dashboard
# Redirect URI: http://localhost:4321/api/auth/x/callback
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=http://localhost:4321/api/auth/x/callback

# ─── 4. GitHub OAuth (Real ID) ──────────────────────────────────
# Setup: https://github.com/settings/developers
# Redirect URI: http://localhost:4321/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:4321/api/auth/github/callback
